cabal-version: 3.0
name: mosaic-plan
version: 0.1.0.0
synopsis: Build MOSAIC workflow plans for .NET hosts
license: Apache-2.0
build-type: Simple

library
  exposed-modules: MosaicPlan
  hs-source-dirs: src
  build-depends: base >=4.16 && <5, aeson >=2.0, bytestring, containers, text
  default-language: GHC2021
  ghc-options: -Wall -Werror

test-suite mosaic-plan-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base >=4.16 && <5, aeson >=2.0, bytestring, mosaic-plan, text
  default-language: GHC2021
  ghc-options: -Wall -Werror
