<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AfrenAI.Mosaic.Mcp</PackageId>
    <Version>0.2.0</Version>
    <Authors>AFREN AI</Authors>
    <Company>AFREN AI</Company>
    <Description>MCP server tool adapter for the MOSAIC bounded workflow engine.</Description>
    <PackageTags>agents;workflow;capability-security;mcp;ai</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AFREN-AI/MOSAIC</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AFREN-AI/MOSAIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <ProjectReference Include="../Mosaic.Core/Mosaic.Core.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
